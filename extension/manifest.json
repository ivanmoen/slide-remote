{
  "manifest_version": 3,
  "name": "Slide Remote — Google Slides bridge",
  "short_name": "Slide Remote",
  "version": "1.0.0",
  "description": "Lets the Slide Remote helper drive Google Slides slideshows over BLE: reads the current slide / total / speaker notes, captures the slide thumbnail, and injects Next/Prev/Black/End commands.",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": [
    "https://docs.google.com/presentation/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/presentation/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Slide Remote bridge"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
